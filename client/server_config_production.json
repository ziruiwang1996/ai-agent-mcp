{
    "mcpServers": {
        "arxiv_server": {
            "transport": "stdio",
            "command": "${PYTHON_PATH}",
            "args": ["${APP_PATH}/mcp-server/arxiv_server.py"],
            "env": {
                "PYTHONPATH": "${APP_PATH}"
            }
        },

        "openfda_server": {
            "transport": "stdio",
            "command": "${PYTHON_PATH}",
            "args": ["${APP_PATH}/mcp-server/openfda_server.py"],
            "env": {
                "PYTHONPATH": "${APP_PATH}"
            }
        },

        "clinicaltrials_server": {
            "transport": "stdio",
            "command": "${PYTHON_PATH}",
            "args": ["${APP_PATH}/mcp-server/clinicaltrials_server.py"],
            "env": {
                "PYTHONPATH": "${APP_PATH}"
            }
        },

        "pdb_server": {
            "transport": "stdio",
            "command": "${PYTHON_PATH}",
            "args": ["${APP_PATH}/mcp-server/pdb_server.py"],
            "env": {
                "PYTHONPATH": "${APP_PATH}"
            }
        }
        
    }
